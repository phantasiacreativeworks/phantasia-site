---
import { SITE } from '../config';
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <img src="/assets/logo.png" alt="Phantasia Creative Works" width="500" height="167" data-logo />
        <p>A custom 3D studio transforming ideas into reality.</p>
        <div class="footer__social">
          <a href={SITE.youtube} target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.7-.5-5.4a2.8 2.8 0 0 0-2-2C18.7 4 12 4 12 4s-6.7 0-8.5.6a2.8 2.8 0 0 0-2 2C1 8.3 1 12 1 12s0 3.7.5 5.4a2.8 2.8 0 0 0 2 2c1.8.6 8.5.6 8.5.6s6.7 0 8.5-.6a2.8 2.8 0 0 0 2-2C23 15.7 23 12 23 12zM9.8 15.3V8.7l5.7 3.3z"></path></svg></a>
          <a href={SITE.instagram} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg></a>
          <a href={SITE.twitter} target="_blank" rel="noopener" aria-label="Twitter / X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 1.9h3.6l-7.9 9 9.3 12.3h-7.3l-5.7-7.5-6.5 7.5H.8l8.4-9.6L0 1.9h7.5l5.2 6.9 6.2-6.9zm-1.3 19h2L7.1 3.8H5z"></path></svg></a>
          <a href={`mailto:${SITE.email}`} aria-label="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 6L2 7"></path></svg></a>
        </div>
      </div>
      <div class="footer__col">
        <h3>Studio</h3>
        <a href="/#services">Services</a>
        <a href="/portfolio">Portfolio</a>
        <a href="/blog">Blog</a>
        <a href="/#process">Process</a>
      </div>
      <div class="footer__col">
        <h3>Work with us</h3>
        <a href="/#pricing">Pricing</a>
        <a href="/#availability">Availability</a>
        <a href="/start">Start a project</a>
      </div>
      <div class="footer__col">
        <h3>Contact</h3>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href={SITE.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
        <a href="/#faq">FAQ</a>
      </div>
    </div>
    <div class="footer__bottom">
      <span>© <span id="year"></span> {SITE.name}. All rights reserved.</span>
      <span>{SITE.location}</span>
    </div>
  </div>
</footer>
