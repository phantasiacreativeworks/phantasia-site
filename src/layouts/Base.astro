---
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  showFloatingCta?: boolean;
}

const { showFloatingCta = true, ...seo } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <SEO {...seo} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Nav />
    <slot />
    <Footer />
    {showFloatingCta && <a class="floating-cta" href="/#contact">Start a project</a>}

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var y = document.getElementById('year');
        if (y) y.textContent = new Date().getFullYear();

        /* theme toggle */
        function setTheme(t) {
          root.setAttribute('data-theme', t);
          var ml = document.querySelector('meta[name="theme-color"]');
          document.querySelectorAll('[data-logo]').forEach(function (img) {
            img.src = t === 'dark' ? '/assets/logo-dark.png' : '/assets/logo.png';
          });
        }
        try {
          var saved = localStorage.getItem('theme');
          if (saved) setTheme(saved);
        } catch (e) {}
        var tt = document.getElementById('themeToggle');
        if (tt)
          tt.addEventListener('click', function () {
            var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            setTheme(next);
            try { localStorage.setItem('theme', next); } catch (e) {}
          });

        /* sticky nav */
        var nav = document.getElementById('nav');
        function sc() { if (nav) nav.classList.toggle('scrolled', window.scrollY > 16); }
        sc();
        window.addEventListener('scroll', sc, { passive: true });

        /* mobile menu */
        var t = document.getElementById('navToggle'),
          l = document.getElementById('navLinks');
        if (t && l) {
          t.addEventListener('click', function () {
            var o = l.classList.toggle('open');
            t.classList.toggle('open', o);
            t.setAttribute('aria-expanded', String(o));
          });
          l.addEventListener('click', function (e) {
            if (e.target.tagName === 'A') {
              l.classList.remove('open');
              t.classList.remove('open');
            }
          });
        }

        /* conversion events: count WhatsApp/email clicks in GA4 (no-op in dev, gtag absent) */
        document.querySelectorAll('a[href*="wa.me"], a[href^="mailto:"]').forEach(function (a) {
          a.addEventListener('click', function () {
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'contact_click', {
                method: a.href.indexOf('wa.me') > -1 ? 'whatsapp' : 'email',
                page_path: location.pathname,
              });
            }
          });
        });

        /* reveal */
        var rm = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
        if (rm) {
          document.querySelectorAll('[data-reveal]').forEach(function (el) { el.classList.add('in'); });
        } else {
          var io = new IntersectionObserver(
            function (es) {
              es.forEach(function (e) {
                if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
          );
          document.querySelectorAll('[data-reveal]').forEach(function (el) { io.observe(el); });
        }
      })();
    </script>
  </body>
</html>
