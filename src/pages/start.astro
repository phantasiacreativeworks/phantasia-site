---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
---

<Base title="Start a project" description="Send Phantasia Creative Works a project brief — character sculpts, product design, or game assets." showFloatingCta={false}>
  <main id="main-content">
    <section class="blog-hero">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Start a project</p>
        <h1 data-reveal data-delay="1">Tell us what you're imagining.</h1>
        <p data-reveal data-delay="2">Two ways in — a quick chat, or a written brief if you've already got the details.</p>
      </div>
    </section>

    <section class="section" style="padding-top:12px">
      <div class="wrap start__grid">
        <div class="start__form panel" data-reveal>
          <h2 class="start__heading">Send a written brief</h2>
          <p class="start__sub">Best for detailed or commercial projects. The more you tell us, the sharper our first reply.</p>
          {SITE.formEndpoint ? (
            <form class="form" id="briefForm" method="POST" action={SITE.formEndpoint}>
              <div class="form__grid">
                <div class="form__row">
                  <label for="f-name">Your name</label>
                  <input id="f-name" type="text" name="name" required autocomplete="name" />
                </div>
                <div class="form__row">
                  <label for="f-email">Email</label>
                  <input id="f-email" type="email" name="email" required autocomplete="email" />
                </div>
                <div class="form__row">
                  <label for="f-type">Project type</label>
                  <select id="f-type" name="project_type" required>
                    <option value="" disabled selected>Choose one…</option>
                    <option>Character sculpting</option>
                    <option>Product design</option>
                    <option>Game asset</option>
                    <option>Something else</option>
                  </select>
                </div>
                <div class="form__row">
                  <label for="f-budget">Budget range</label>
                  <select id="f-budget" name="budget" required>
                    <option value="" disabled selected>Choose one…</option>
                    <option>$100 – 400</option>
                    <option>$400 – 600</option>
                    <option>$600 – 1,000</option>
                    <option>Above $1,000</option>
                    <option>Not sure yet</option>
                  </select>
                </div>
              </div>
              <div class="form__row">
                <label for="f-desc">Tell us about the project</label>
                <textarea id="f-desc" name="message" rows="6" required placeholder="What are we making? Any deadlines, sizes, or must-haves?"></textarea>
              </div>
              <div class="form__row">
                <label for="f-refs">Reference links <span class="form__opt">(optional)</span></label>
                <input id="f-refs" type="text" name="references" placeholder="Drive folders, Pinterest boards, ArtStation links…" />
              </div>
              <div class="form__actions">
                <button class="btn btn--primary" type="submit" id="briefSubmit">Send the brief</button>
                <p class="form__error" id="briefError" hidden>Something went wrong — please try again, or reach us on WhatsApp instead.</p>
              </div>
            </form>
          ) : (
            <div class="form__fallback">
              <p>The written-brief form is warming up. Meanwhile, both of these reach us directly:</p>
              <div class="hero__actions" style="margin-top:20px">
                <a class="btn btn--primary" href={SITE.whatsapp} target="_blank" rel="noopener">Message on WhatsApp</a>
                <a class="btn btn--ghost" href={`mailto:${SITE.email}`}>Email the studio</a>
              </div>
            </div>
          )}
        </div>

        <aside class="start__aside" data-reveal data-delay="1">
          <div class="panel start__chat">
            <h2 class="start__heading">Prefer to chat?</h2>
            <p class="start__sub">Fastest way to reach us. Send a reference image and we'll take it from there.</p>
            <a class="btn btn--whatsapp start__wa" href={SITE.whatsapp} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.4A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.8.8.8-2.8-.2-.3A8 8 0 1 1 12 20zm4.4-5.9c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1-.6.8-.8.9-.3.2-.5 0a6.6 6.6 0 0 1-3.3-2.8c-.2-.4.2-.4.6-1.2.1-.2 0-.3 0-.5l-.7-1.7c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3c-.2.3-.9.9-.9 2.1s.9 2.5 1 2.6a9.3 9.3 0 0 0 3.7 3.3c1.4.5 1.9.6 2.6.5.4-.1 1.4-.6 1.6-1.1s.2-1 .1-1.1z"></path></svg>
              Message on WhatsApp
            </a>
            <a class="start__mail" href={`mailto:${SITE.email}`}>or email {SITE.email}</a>
          </div>
          <div class="start__facts">
            <p><span class="dot"></span> Every brief gets a personal reply within 24 hours</p>
            <p><span class="dot"></span> Most projects start within a week</p>
            <p><span class="dot"></span> NDA-friendly — much of our work is confidential</p>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <script is:inline>
    /* AJAX submit → branded /thanks page (works on Formspree free tier) */
    (function () {
      var form = document.getElementById('briefForm');
      if (!form) return;
      form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        var btn = document.getElementById('briefSubmit');
        var err = document.getElementById('briefError');
        err.hidden = true;
        btn.disabled = true;
        btn.textContent = 'Sending…';
        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        })
          .then(function (res) {
            if (!res.ok) throw new Error('bad status');
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'brief_submit', { page_path: location.pathname });
            }
            window.location.href = '/thanks';
          })
          .catch(function () {
            err.hidden = false;
            btn.disabled = false;
            btn.textContent = 'Send the brief';
          });
      });
    })();
  </script>
</Base>
