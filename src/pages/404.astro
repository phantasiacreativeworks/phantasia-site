---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex={true} showFloatingCta={false}>
  <main class="nf" id="main-content">
    <h1>404</h1>
    <h2>This page wandered off.</h2>
    <p>The page you're looking for doesn't exist or may have moved. Let's get you back on track.</p>
    <div class="nf__links">
      <a class="btn btn--primary" href="/">Return home</a>
      <a class="btn btn--ghost" href="/#services">Services</a>
      <a class="btn btn--ghost" href="/#portfolio">Portfolio</a>
    </div>
  </main>
</Base>
